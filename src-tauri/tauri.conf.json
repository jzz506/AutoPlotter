{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoPlotter",
  "version": "1.0.0",
  "identifier": "com.autoplotter.local",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AutoPlotter",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "dragDropEnabled": false,
        "fullscreen": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": null
    },
    "copyright": "MIT License",
    "shortDescription": "本地数据分析与绘图",
    "longDescription": "AutoPlotter 是本地可视化自动数据分析与绘图应用，所有数据仅在本机处理。"
  }
}
